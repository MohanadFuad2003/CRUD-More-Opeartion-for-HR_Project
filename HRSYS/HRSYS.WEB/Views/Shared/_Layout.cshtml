@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool hideSidebar =
        (ctrl == "Account" && (action == "Login" || action == "Register"))
        || (ctrl == "Home" && action == "Index");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - HR System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/dashboard.css" rel="stylesheet" />
    <link href="~/css/forms.css" rel="stylesheet" />
</head>

<body>

    @if (!hideSidebar)
    {
        <div class="sidebar">
            <h3>HR System</h3>
            <a href="/Dashboard/Index">Dashboard</a>
            <a href="/Dashboard/Create">Add Employee</a>
            <a href="/Account/Login">Logout</a>
        </div>
    }

    <div class="content" style="@(hideSidebar ? "margin-left:0" : "")">
        @RenderBody()
    </div>

    <script src="~/js/site.js"></script>
    <script src="~/js/dashboard.js"></script>

</body>
</html>
