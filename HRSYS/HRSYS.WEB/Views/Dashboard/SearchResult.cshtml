<h2>Employee Details</h2>

<table class="table table-bordered shadow-sm">
    <tr><th>ID</th><td>@Model.empID</td></tr>
    <tr><th>Name</th><td>@Model.fullName</td></tr>
    <tr><th>Email</th><td>@Model.email</td></tr>
    <tr><th>Salary</th><td>@Model.salary</td></tr>
    <tr><th>Department</th><td>@Model.department</td></tr>
</table>

<a class="btn btn-secondary mt-3" href="/Dashboard/Index">Back</a>
