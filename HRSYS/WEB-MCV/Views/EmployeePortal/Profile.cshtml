@model HRSYS.Domain.DTOs.EmployeeProfileDto
@{
    Layout = "_Layout";
    ViewData["Title"] = "Employee Profile";
}

<section class="profile-grid" data-reveal>
    <div class="glass-panel profile-summary">
        <p class="eyebrow">
            <i class="fa-solid fa-id-card"></i> Employee Profile
        </p>
        <h2>@Model.FullName</h2>
        <p class="muted">@Model.Email</p>

        <div class="metric-card">
            <span class="metric-label">
                <i class="fa-solid fa-building"></i> Department
            </span>
            <span class="metric-value">@Model.Department</span>
        </div>

        <div class="metric-card">
            <span class="metric-label">
                <i class="fa-solid fa-money-bill"></i> Salary
            </span>
            <span class="metric-value">@Model.Salary.ToString("C0")</span>
        </div>

        <div class="metric-card">
            <span class="metric-label">
                <i class="fa-solid fa-calendar"></i> Joined
            </span>
            <span class="metric-value">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
        </div>

        <a class="btn ghost w-100" href="/EmployeePortal/Logout">
            <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
        </a>
    </div>

    <div class="profile-details glass-panel">
        <h3>
            <i class="fa-solid fa-info-circle"></i> Additional Details
        </h3>
        <p class="muted">
            This profile shows your basic information. If you need to update your data, please contact the HR team.
        </p>

        <div class="detail-list">
            <div class="detail-item">
                <span class="label"><i class="fa-solid fa-hashtag"></i> Employee ID</span>
                <strong>#@Model.EmpID</strong>
            </div>
            <div class="detail-item">
                <span class="label"><i class="fa-solid fa-envelope"></i> Email</span>
                <strong>@Model.Email</strong>
            </div>
            <div class="detail-item">
                <span class="label"><i class="fa-solid fa-building"></i> Department</span>
                <strong>@Model.Department</strong>
            </div>
            <div class="detail-item">
                <span class="label"><i class="fa-solid fa-calendar-days"></i> Created At</span>
                <strong>@Model.CreatedAt.ToString("dddd, dd MMM yyyy")</strong>
            </div>
        </div>

    </div>
</section>
